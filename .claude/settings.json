{
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-secrets-before-git.sh",
            "if": "Bash(git commit *), Bash(git push *)"
          }
        ]
      }
    ]
  }
}
